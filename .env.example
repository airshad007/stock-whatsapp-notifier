# Telegram bot credentials
# 1. Message @BotFather in Telegram, send /newbot, follow the prompts.
#    It gives you a token that looks like 123456789:AAExampleTokenStringHere
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenStringHere

# 2. Send any message (e.g. "hi") to your new bot from your own Telegram account,
#    then visit https://api.telegram.org/bot<your-token>/getUpdates in a browser -
#    look for "chat":{"id": ...} in the JSON response and use that number here.
TELEGRAM_CHAT_ID=123456789
